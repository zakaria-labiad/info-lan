{
  "name": "info-lan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:sync-schemas": "tsx scripts/sync-prisma-schemas.ts",
    "db:parity": "tsx scripts/check-prisma-parity.ts",
    "db:generate": "npm run db:sync-schemas && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:sqlite": "prisma migrate dev --schema prisma/schema.sqlite.prisma",
    "db:migrate:postgresql": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:prepare:sqlite": "tsx scripts/prepare-sqlite-db.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
